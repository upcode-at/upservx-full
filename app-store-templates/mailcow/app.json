{
  "name": "Mailcow",
  "description": "Complete self-hosted mail server suite with webmail (SOGo), spam filter (Rspamd), antivirus (ClamAV), admin UI, Let's Encrypt SSL, and more. Full alternative to hosted email services.",
  "version": "latest",
  "category": "other",
  "icon": "📬",
  "author": "Mailcow",
  "ports": [
    "25:25",
    "80:80",
    "110:110",
    "143:143",
    "443:443",
    "465:465",
    "587:587",
    "993:993",
    "995:995",
    "4190:4190"
  ],
  "volumes": [
    "/opt/upservx/data/mailcow/vmail:/var/vmail",
    "/opt/upservx/data/mailcow/mysql:/var/lib/mysql",
    "/opt/upservx/data/mailcow/redis:/data",
    "/opt/upservx/data/mailcow/ssl:/etc/ssl/mail"
  ],
  "environment": {
    "MAILCOW_HOSTNAME": "mail.example.com",
    "DBNAME": "mailcow",
    "DBUSER": "mailcow",
    "DBPASS": "changeme_db_password",
    "DBROOT": "changeme_db_root_password",
    "TZ": "Europe/Berlin",
    "HTTP_PORT": "80",
    "HTTPS_PORT": "443",
    "SMTP_PORT": "25",
    "SMTPS_PORT": "465",
    "SUBMISSION_PORT": "587",
    "IMAP_PORT": "143",
    "IMAPS_PORT": "993",
    "POP_PORT": "110",
    "POPS_PORT": "995",
    "SIEVE_PORT": "4190"
  }
}
