{
  "schema_version": 1,
  "id": "neo4j",
  "name": "Neo4j",
  "description": "Leading graph database management system. Store, query and visualize highly connected data using the Cypher query language. Includes Neo4j Browser for interactive graph exploration.",
  "version": "5",
  "category": "database",
  "icon": "🕸️",
  "author": "Neo4j, Inc.",
  "ports": [
    {
      "host": 7474,
      "container": 7474,
      "protocol": "tcp",
      "description": ""
    },
    {
      "host": 7687,
      "container": 7687,
      "protocol": "tcp",
      "description": ""
    }
  ],
  "volumes": [
    {
      "host": "/opt/upservx/data/neo4j/data",
      "container": "/data",
      "mode": "rw",
      "description": ""
    },
    {
      "host": "/opt/upservx/data/neo4j/logs",
      "container": "/logs",
      "mode": "rw",
      "description": ""
    },
    {
      "host": "/opt/upservx/data/neo4j/import",
      "container": "/var/lib/neo4j/import",
      "mode": "rw",
      "description": ""
    },
    {
      "host": "/opt/upservx/data/neo4j/plugins",
      "container": "/plugins",
      "mode": "rw",
      "description": ""
    }
  ],
  "environment": [
    {
      "name": "APP_DATA_DIR",
      "label": "App Data Dir",
      "description": "Managed per-installation data directory.",
      "default": "",
      "required": true,
      "secret": false,
      "generate": false,
      "managed": true
    },
    {
      "name": "NEO4J_PASSWORD",
      "label": "Neo4J Password",
      "description": "",
      "default": "",
      "required": true,
      "secret": true,
      "generate": true,
      "min_length": 24
    },
    {
      "name": "NEO4J_PLUGINS",
      "label": "Neo4J Plugins",
      "description": "",
      "default": "[\"apoc\"]",
      "required": false,
      "secret": false,
      "generate": false
    },
    {
      "name": "NEO4J_dbms_memory_heap_initial__size",
      "label": "Neo4J Dbms Memory Heap Initial  Size",
      "description": "",
      "default": "512m",
      "required": false,
      "secret": false,
      "generate": false
    },
    {
      "name": "NEO4J_dbms_memory_heap_max__size",
      "label": "Neo4J Dbms Memory Heap Max  Size",
      "description": "",
      "default": "1G",
      "required": false,
      "secret": false,
      "generate": false
    },
    {
      "name": "NEO4J_dbms_memory_pagecache_size",
      "label": "Neo4J Dbms Memory Pagecache Size",
      "description": "",
      "default": "512m",
      "required": false,
      "secret": false,
      "generate": false
    }
  ],
  "update": {
    "strategy": "compose-pull-recreate"
  }
}
