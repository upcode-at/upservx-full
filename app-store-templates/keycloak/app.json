{
  "name": "Keycloak",
  "description": "Open-source Identity and Access Management solution. Provides single sign-on (SSO), social login, user federation, and fine-grained authorization for modern applications.",
  "version": "latest",
  "category": "security",
  "icon": "🔑",
  "author": "Red Hat",
  "ports": [
    "8080:8080",
    "8443:8443"
  ],
  "volumes": [
    "/opt/upservx/data/keycloak/data:/opt/keycloak/data"
  ],
  "environment": {
    "KEYCLOAK_ADMIN": "admin",
    "KEYCLOAK_ADMIN_PASSWORD": "admin",
    "KC_DB": "postgres",
    "KC_DB_URL": "jdbc:postgresql://keycloak-db:5432/keycloak",
    "KC_DB_USERNAME": "keycloak",
    "KC_DB_PASSWORD": "keycloak",
    "KC_HOSTNAME": "localhost",
    "KC_HTTP_ENABLED": "true",
    "KC_PROXY": "edge"
  }
}
