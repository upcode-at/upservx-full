{
  "schema_version": 1,
  "id": "keycloak",
  "name": "Keycloak",
  "description": "Open-source Identity and Access Management solution. Provides single sign-on (SSO), social login, user federation, and fine-grained authorization for modern applications.",
  "version": "26.3.2",
  "category": "security",
  "icon": "🔑",
  "author": "Red Hat",
  "ports": [
    {
      "host": 8080,
      "container": 8080,
      "protocol": "tcp",
      "description": ""
    },
    {
      "host": 8443,
      "container": 8443,
      "protocol": "tcp",
      "description": ""
    }
  ],
  "volumes": [
    {
      "host": "/opt/upservx/data/keycloak/data",
      "container": "/opt/keycloak/data",
      "mode": "rw",
      "description": ""
    }
  ],
  "environment": [
    {
      "name": "APP_DATA_DIR",
      "label": "App Data Dir",
      "description": "Managed per-installation data directory.",
      "default": "",
      "required": true,
      "secret": false,
      "generate": false,
      "managed": true
    },
    {
      "name": "KC_DB",
      "label": "Kc Db",
      "description": "",
      "default": "postgres",
      "required": false,
      "secret": false,
      "generate": false
    },
    {
      "name": "KC_DB_PASSWORD",
      "label": "Kc Db Password",
      "description": "",
      "default": "",
      "required": true,
      "secret": true,
      "generate": true,
      "min_length": 24
    },
    {
      "name": "KC_DB_URL",
      "label": "Kc Db Url",
      "description": "",
      "default": "jdbc:postgresql://keycloak-db:5432/keycloak",
      "required": false,
      "secret": false,
      "generate": false
    },
    {
      "name": "KC_DB_USERNAME",
      "label": "Kc Db Username",
      "description": "",
      "default": "keycloak",
      "required": false,
      "secret": false,
      "generate": false
    },
    {
      "name": "KC_HOSTNAME",
      "label": "Kc Hostname",
      "description": "",
      "default": "localhost",
      "required": false,
      "secret": false,
      "generate": false
    },
    {
      "name": "KC_HTTP_ENABLED",
      "label": "Kc Http Enabled",
      "description": "",
      "default": "true",
      "required": false,
      "secret": false,
      "generate": false
    },
    {
      "name": "KC_PROXY",
      "label": "Kc Proxy",
      "description": "",
      "default": "edge",
      "required": false,
      "secret": false,
      "generate": false
    },
    {
      "name": "KEYCLOAK_ADMIN",
      "label": "Keycloak Admin",
      "description": "",
      "default": "admin",
      "required": false,
      "secret": false,
      "generate": false
    },
    {
      "name": "KEYCLOAK_ADMIN_PASSWORD",
      "label": "Keycloak Admin Password",
      "description": "",
      "default": "",
      "required": true,
      "secret": true,
      "generate": true,
      "min_length": 24
    }
  ],
  "update": {
    "strategy": "compose-pull-recreate"
  }
}
