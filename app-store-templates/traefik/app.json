{
  "schema_version": 1,
  "id": "traefik",
  "name": "Traefik",
  "description": "Modern HTTP reverse proxy and load balancer that makes deploying microservices easy. Supports automatic SSL via Let's Encrypt, Docker-native service discovery, and a built-in dashboard.",
  "version": "3.5.0",
  "category": "networking",
  "icon": "🔀",
  "author": "Traefik Labs",
  "ports": [
    {
      "host": 80,
      "container": 80,
      "protocol": "tcp",
      "description": ""
    },
    {
      "host": 443,
      "container": 443,
      "protocol": "tcp",
      "description": ""
    },
    {
      "host": 8080,
      "container": 8080,
      "protocol": "tcp",
      "description": ""
    }
  ],
  "volumes": [
    {
      "host": "/opt/upcode-harbor/data/traefik/config",
      "container": "/etc/traefik",
      "mode": "rw",
      "description": ""
    },
    {
      "host": "/opt/upcode-harbor/data/traefik/acme",
      "container": "/acme",
      "mode": "rw",
      "description": ""
    },
    {
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "ro",
      "description": ""
    }
  ],
  "environment": [
    {
      "name": "APP_DATA_DIR",
      "label": "App Data Dir",
      "description": "Managed per-installation data directory.",
      "default": "",
      "required": true,
      "secret": false,
      "generate": false,
      "managed": true
    },
    {
      "name": "TRAEFIK_API_DASHBOARD",
      "label": "Traefik Api Dashboard",
      "description": "",
      "default": "true",
      "required": false,
      "secret": false,
      "generate": false
    },
    {
      "name": "TRAEFIK_API_INSECURE",
      "label": "Traefik Api Insecure",
      "description": "",
      "default": "true",
      "required": false,
      "secret": false,
      "generate": false
    },
    {
      "name": "TRAEFIK_ENTRYPOINTS_WEBSECURE_ADDRESS",
      "label": "Traefik Entrypoints Websecure Address",
      "description": "",
      "default": ":443",
      "required": false,
      "secret": false,
      "generate": false
    },
    {
      "name": "TRAEFIK_ENTRYPOINTS_WEB_ADDRESS",
      "label": "Traefik Entrypoints Web Address",
      "description": "",
      "default": ":80",
      "required": false,
      "secret": false,
      "generate": false
    },
    {
      "name": "TRAEFIK_LOG_LEVEL",
      "label": "Traefik Log Level",
      "description": "",
      "default": "INFO",
      "required": false,
      "secret": false,
      "generate": false
    },
    {
      "name": "TRAEFIK_PROVIDERS_DOCKER",
      "label": "Traefik Providers Docker",
      "description": "",
      "default": "true",
      "required": false,
      "secret": false,
      "generate": false
    },
    {
      "name": "TRAEFIK_PROVIDERS_DOCKER_EXPOSEDBYDEFAULT",
      "label": "Traefik Providers Docker Exposedbydefault",
      "description": "",
      "default": "false",
      "required": false,
      "secret": false,
      "generate": false
    }
  ],
  "update": {
    "strategy": "compose-pull-recreate"
  }
}
