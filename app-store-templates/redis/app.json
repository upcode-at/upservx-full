{
  "schema_version": 1,
  "id": "redis",
  "name": "Redis",
  "description": "In-memory data structure store. Fast, versatile key-value database used as cache, message broker, and real-time data store.",
  "version": "7.4.5",
  "category": "database",
  "icon": "🔴",
  "author": "Redis Ltd.",
  "ports": [
    {
      "host": 6379,
      "container": 6379,
      "protocol": "tcp",
      "description": ""
    }
  ],
  "volumes": [
    {
      "host": "/opt/upservx/data/redis/data",
      "container": "/data",
      "mode": "rw",
      "description": ""
    }
  ],
  "environment": [
    {
      "name": "APP_DATA_DIR",
      "label": "App Data Dir",
      "description": "Managed per-installation data directory.",
      "default": "",
      "required": true,
      "secret": false,
      "generate": false,
      "managed": true
    },
    {
      "name": "REDIS_PASSWORD",
      "label": "Redis Password",
      "description": "",
      "default": "",
      "required": true,
      "secret": true,
      "generate": true,
      "min_length": 24
    }
  ],
  "update": {
    "strategy": "compose-pull-recreate"
  }
}
