{
  "schema_version": 1,
  "id": "apache-guacamole",
  "name": "Apache Guacamole",
  "description": "Clientless remote desktop gateway. Access VNC, RDP, and SSH connections directly from your browser – no plugins or client software required.",
  "version": "1.6.0",
  "category": "networking",
  "icon": "🌐",
  "author": "Apache Software Foundation",
  "ports": [
    {
      "host": 8080,
      "container": 8080,
      "protocol": "tcp",
      "description": ""
    }
  ],
  "volumes": [
    {
      "host": "/opt/upcode-harbor/data/apache-guacamole/drive",
      "container": "/drive",
      "mode": "rw",
      "description": ""
    },
    {
      "host": "/opt/upcode-harbor/data/apache-guacamole/record",
      "container": "/record",
      "mode": "rw",
      "description": ""
    }
  ],
  "environment": [
    {
      "name": "APP_DATA_DIR",
      "label": "App Data Dir",
      "description": "Managed per-installation data directory.",
      "default": "",
      "required": true,
      "secret": false,
      "generate": false,
      "managed": true
    },
    {
      "name": "GUACD_HOSTNAME",
      "label": "Guacd Hostname",
      "description": "",
      "default": "guacd",
      "required": false,
      "secret": false,
      "generate": false
    },
    {
      "name": "GUACD_PORT",
      "label": "Guacd Port",
      "description": "",
      "default": "4822",
      "required": false,
      "secret": false,
      "generate": false
    },
    {
      "name": "POSTGRES_PASSWORD",
      "label": "Postgres Password",
      "description": "",
      "default": "",
      "required": true,
      "secret": true,
      "generate": true,
      "min_length": 24
    },
    {
      "name": "POSTGRES_USER",
      "label": "Postgres User",
      "description": "",
      "default": "guacamole_user",
      "required": false,
      "secret": false,
      "generate": false
    }
  ],
  "update": {
    "strategy": "compose-pull-recreate"
  }
}
