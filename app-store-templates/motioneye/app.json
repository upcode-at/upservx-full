{
  "schema_version": 1,
  "id": "motioneye",
  "name": "MotionEye",
  "description": "Web-based frontend for the motion daemon. Turn any camera into a network camera and manage multiple video surveillance streams from a single interface.",
  "version": "0.43.1",
  "category": "monitoring",
  "icon": "📷",
  "author": "ccrisan / jshridha",
  "ports": [
    {
      "host": 8765,
      "container": 8765,
      "protocol": "tcp",
      "description": ""
    }
  ],
  "volumes": [
    {
      "host": "/opt/upcode-harbor/data/motioneye/config",
      "container": "/etc/motioneye",
      "mode": "rw",
      "description": ""
    },
    {
      "host": "/opt/upcode-harbor/data/motioneye/media",
      "container": "/var/lib/motioneye",
      "mode": "rw",
      "description": ""
    }
  ],
  "environment": [
    {
      "name": "APP_DATA_DIR",
      "label": "App Data Dir",
      "description": "Managed per-installation data directory.",
      "default": "",
      "required": true,
      "secret": false,
      "generate": false,
      "managed": true
    },
    {
      "name": "TZ",
      "label": "Tz",
      "description": "",
      "default": "Europe/Berlin",
      "required": false,
      "secret": false,
      "generate": false
    }
  ],
  "update": {
    "strategy": "compose-pull-recreate"
  }
}
