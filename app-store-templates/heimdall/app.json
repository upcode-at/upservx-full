{
  "schema_version": 1,
  "id": "heimdall",
  "name": "Heimdall",
  "description": "An elegant solution to organise all your web applications. Heimdall is a dashboard for all your web applications — and it doesn't have to be limited to web applications.",
  "version": "2.7.6",
  "category": "dashboard",
  "icon": "🏠",
  "author": "linuxserver.io",
  "ports": [
    {
      "host": 8888,
      "container": 80,
      "protocol": "tcp",
      "description": ""
    },
    {
      "host": 8889,
      "container": 443,
      "protocol": "tcp",
      "description": ""
    }
  ],
  "volumes": [
    {
      "host": "/opt/upservx/data/heimdall",
      "container": "/config",
      "mode": "rw",
      "description": ""
    }
  ],
  "environment": [
    {
      "name": "APP_DATA_DIR",
      "label": "App Data Dir",
      "description": "Managed per-installation data directory.",
      "default": "",
      "required": true,
      "secret": false,
      "generate": false,
      "managed": true
    },
    {
      "name": "PGID",
      "label": "Pgid",
      "description": "",
      "default": "1000",
      "required": false,
      "secret": false,
      "generate": false
    },
    {
      "name": "PUID",
      "label": "Puid",
      "description": "",
      "default": "1000",
      "required": false,
      "secret": false,
      "generate": false
    },
    {
      "name": "TZ",
      "label": "Tz",
      "description": "",
      "default": "Europe/Berlin",
      "required": false,
      "secret": false,
      "generate": false
    }
  ],
  "update": {
    "strategy": "compose-pull-recreate"
  }
}
