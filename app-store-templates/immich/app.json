{
  "schema_version": 1,
  "id": "immich",
  "name": "Immich",
  "description": "A high-performance, self-hosted photo and video backup solution. Immich offers automatic mobile backup, facial recognition, object detection, map view, shared albums, and a Google Photos-like experience – all on your own server.",
  "version": "1.136.0",
  "category": "media",
  "icon": "📸",
  "author": "Immich",
  "ports": [
    {
      "host": 2283,
      "container": 2283,
      "protocol": "tcp",
      "description": ""
    }
  ],
  "volumes": [
    {
      "host": "/opt/upservx/data/immich/upload",
      "container": "/usr/src/app/upload",
      "mode": "rw",
      "description": ""
    },
    {
      "host": "/opt/upservx/data/immich-db",
      "container": "/var/lib/postgresql/data",
      "mode": "rw",
      "description": ""
    }
  ],
  "environment": [
    {
      "name": "APP_DATA_DIR",
      "label": "App Data Dir",
      "description": "Managed per-installation data directory.",
      "default": "",
      "required": true,
      "secret": false,
      "generate": false,
      "managed": true
    },
    {
      "name": "DB_DATABASE_NAME",
      "label": "Db Database Name",
      "description": "",
      "default": "immich",
      "required": false,
      "secret": false,
      "generate": false
    },
    {
      "name": "DB_PASSWORD",
      "label": "Db Password",
      "description": "",
      "default": "",
      "required": true,
      "secret": true,
      "generate": true,
      "min_length": 24
    },
    {
      "name": "DB_USERNAME",
      "label": "Db Username",
      "description": "",
      "default": "immich",
      "required": false,
      "secret": false,
      "generate": false
    }
  ],
  "update": {
    "strategy": "compose-pull-recreate"
  }
}
