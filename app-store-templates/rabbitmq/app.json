{
  "schema_version": 1,
  "id": "rabbitmq",
  "name": "RabbitMQ",
  "description": "Open-source message broker supporting AMQP, MQTT, and STOMP protocols. Enables reliable asynchronous communication between services. Includes the RabbitMQ Management UI for monitoring queues, exchanges, and connections.",
  "version": "4-management",
  "category": "other",
  "icon": "🐇",
  "author": "Broadcom / VMware",
  "ports": [
    {
      "host": 5672,
      "container": 5672,
      "protocol": "tcp",
      "description": ""
    },
    {
      "host": 15672,
      "container": 15672,
      "protocol": "tcp",
      "description": ""
    }
  ],
  "volumes": [
    {
      "host": "/opt/upcode-harbor/data/rabbitmq/data",
      "container": "/var/lib/rabbitmq",
      "mode": "rw",
      "description": ""
    },
    {
      "host": "/opt/upcode-harbor/data/rabbitmq/logs",
      "container": "/var/log/rabbitmq",
      "mode": "rw",
      "description": ""
    }
  ],
  "environment": [
    {
      "name": "APP_DATA_DIR",
      "label": "App Data Dir",
      "description": "Managed per-installation data directory.",
      "default": "",
      "required": true,
      "secret": false,
      "generate": false,
      "managed": true
    },
    {
      "name": "RABBITMQ_DEFAULT_PASS",
      "label": "Rabbitmq Default Pass",
      "description": "",
      "default": "",
      "required": true,
      "secret": true,
      "generate": true,
      "min_length": 24
    },
    {
      "name": "RABBITMQ_DEFAULT_USER",
      "label": "Rabbitmq Default User",
      "description": "",
      "default": "admin",
      "required": false,
      "secret": false,
      "generate": false
    },
    {
      "name": "RABBITMQ_DEFAULT_VHOST",
      "label": "Rabbitmq Default Vhost",
      "description": "",
      "default": "/",
      "required": false,
      "secret": false,
      "generate": false
    }
  ],
  "update": {
    "strategy": "compose-pull-recreate"
  }
}
