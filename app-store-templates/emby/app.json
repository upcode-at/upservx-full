{
  "schema_version": 1,
  "id": "emby",
  "name": "Emby Server",
  "description": "Bring all your home videos, music, and photos together into one place. Stream to your devices from anywhere with Emby's media server software.",
  "version": "4.8.11.0",
  "category": "media",
  "icon": "📺",
  "author": "Emby LLC",
  "ports": [
    {
      "host": 8096,
      "container": 8096,
      "protocol": "tcp",
      "description": ""
    },
    {
      "host": 8920,
      "container": 8920,
      "protocol": "tcp",
      "description": ""
    }
  ],
  "volumes": [
    {
      "host": "/opt/upservx/data/emby/config",
      "container": "/config",
      "mode": "rw",
      "description": ""
    },
    {
      "host": "/mnt/media",
      "container": "/media",
      "mode": "rw",
      "description": ""
    }
  ],
  "environment": [
    {
      "name": "APP_DATA_DIR",
      "label": "App Data Dir",
      "description": "Managed per-installation data directory.",
      "default": "",
      "required": true,
      "secret": false,
      "generate": false,
      "managed": true
    },
    {
      "name": "PGID",
      "label": "Pgid",
      "description": "",
      "default": "1000",
      "required": false,
      "secret": false,
      "generate": false
    },
    {
      "name": "PUID",
      "label": "Puid",
      "description": "",
      "default": "1000",
      "required": false,
      "secret": false,
      "generate": false
    },
    {
      "name": "TZ",
      "label": "Tz",
      "description": "",
      "default": "Europe/Vienna",
      "required": false,
      "secret": false,
      "generate": false
    }
  ],
  "update": {
    "strategy": "compose-pull-recreate"
  }
}
