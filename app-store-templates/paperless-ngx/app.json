{
  "schema_version": 1,
  "id": "paperless-ngx",
  "name": "Paperless-ngx",
  "description": "A community-supported supercharged version of paperless: scan, index and archive all your physical documents",
  "version": "2.18.1",
  "category": "document",
  "icon": "📄",
  "author": "paperless-ngx",
  "website": "https://docs.paperless-ngx.com/",
  "repository": "https://github.com/paperless-ngx/paperless-ngx",
  "tags": [
    "document-management",
    "ocr",
    "scanning",
    "archive",
    "productivity"
  ],
  "ports": [
    {
      "host": 8000,
      "container": 8000,
      "protocol": "tcp",
      "description": "Web interface"
    }
  ],
  "volumes": [
    {
      "host": "./data",
      "container": "/usr/src/paperless/data",
      "mode": "rw",
      "description": "Application data"
    },
    {
      "host": "./media",
      "container": "/usr/src/paperless/media",
      "mode": "rw",
      "description": "Document storage"
    },
    {
      "host": "./export",
      "container": "/usr/src/paperless/export",
      "mode": "rw",
      "description": "Export directory"
    },
    {
      "host": "./consume",
      "container": "/usr/src/paperless/consume",
      "mode": "rw",
      "description": "Document intake directory"
    }
  ],
  "environment": [
    {
      "name": "PAPERLESS_ADMIN_MAIL",
      "label": "Paperless Admin Mail",
      "description": "Admin email address",
      "default": "",
      "required": true,
      "secret": false,
      "generate": false
    },
    {
      "name": "PAPERLESS_ADMIN_PASSWORD",
      "label": "Paperless Admin Password",
      "description": "Initial admin password",
      "default": "",
      "required": true,
      "secret": true,
      "generate": true,
      "min_length": 24
    },
    {
      "name": "PAPERLESS_ADMIN_USER",
      "label": "Paperless Admin User",
      "description": "Initial admin username",
      "default": "admin",
      "required": false,
      "secret": false,
      "generate": false
    },
    {
      "name": "PAPERLESS_DBHOST",
      "label": "Paperless Dbhost",
      "description": "PostgreSQL database host",
      "default": "db",
      "required": false,
      "secret": false,
      "generate": false
    },
    {
      "name": "PAPERLESS_DBNAME",
      "label": "Paperless Dbname",
      "description": "Database name",
      "default": "paperless",
      "required": false,
      "secret": false,
      "generate": false
    },
    {
      "name": "PAPERLESS_DBPASS",
      "label": "Paperless Dbpass",
      "description": "Database password",
      "default": "",
      "required": true,
      "secret": true,
      "generate": true,
      "min_length": 24
    },
    {
      "name": "PAPERLESS_DBUSER",
      "label": "Paperless Dbuser",
      "description": "Database user",
      "default": "paperless",
      "required": false,
      "secret": false,
      "generate": false
    },
    {
      "name": "PAPERLESS_OCR_LANGUAGE",
      "label": "Paperless Ocr Language",
      "description": "OCR language codes (e.g., deu+eng for German and English)",
      "default": "deu+eng",
      "required": false,
      "secret": false,
      "generate": false
    },
    {
      "name": "PAPERLESS_PORT",
      "label": "Paperless Port",
      "description": "",
      "default": "8000",
      "required": false,
      "secret": false,
      "generate": false
    },
    {
      "name": "PAPERLESS_REDIS",
      "label": "Paperless Redis",
      "description": "Redis connection string",
      "default": "redis://redis:6379",
      "required": false,
      "secret": false,
      "generate": false
    },
    {
      "name": "PAPERLESS_SECRET_KEY",
      "label": "Paperless Secret Key",
      "description": "Secret key for encryption (generate a random string)",
      "default": "",
      "required": true,
      "secret": true,
      "generate": true,
      "min_length": 24
    },
    {
      "name": "PAPERLESS_TIME_ZONE",
      "label": "Paperless Time Zone",
      "description": "Timezone for the application",
      "default": "Europe/Berlin",
      "required": false,
      "secret": false,
      "generate": false
    },
    {
      "name": "PAPERLESS_URL",
      "label": "Paperless Url",
      "description": "Public URL for the application",
      "default": "http://localhost:8000",
      "required": false,
      "secret": false,
      "generate": false
    },
    {
      "name": "USERMAP_GID",
      "label": "Usermap Gid",
      "description": "",
      "default": "1000",
      "required": false,
      "secret": false,
      "generate": false
    },
    {
      "name": "USERMAP_UID",
      "label": "Usermap Uid",
      "description": "",
      "default": "1000",
      "required": false,
      "secret": false,
      "generate": false
    }
  ],
  "requirements": {
    "memory": "2GB",
    "cpu": "2 cores",
    "disk": "10GB"
  },
  "notes": [
    "Paperless-ngx requires PostgreSQL and Redis to function",
    "After first start, create an admin user with the environment variables",
    "Place documents in the consume directory for automatic processing",
    "Configure OCR_LANGUAGE for your preferred languages",
    "Generate a secure PAPERLESS_SECRET_KEY (at least 32 random characters)",
    "Access the web interface at http://your-server:8000"
  ],
  "update": {
    "strategy": "compose-pull-recreate"
  }
}
