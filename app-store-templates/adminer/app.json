{
  "schema_version": 1,
  "id": "adminer",
  "name": "Adminer",
  "description": "Lightweight database management tool. Single-file alternative to phpMyAdmin supporting MySQL, PostgreSQL, SQLite, MS SQL, Oracle, and more.",
  "version": "5.5.1",
  "category": "tools",
  "icon": "🔧",
  "author": "Adminer Team",
  "ports": [
    {
      "host": 8083,
      "container": 8080,
      "protocol": "tcp",
      "description": ""
    }
  ],
  "volumes": [],
  "environment": [
    {
      "name": "ADMINER_DEFAULT_SERVER",
      "label": "Adminer Default Server",
      "description": "",
      "default": "mysql",
      "required": false,
      "secret": false,
      "generate": false
    },
    {
      "name": "ADMINER_DESIGN",
      "label": "Adminer Design",
      "description": "",
      "default": "pepa-linha",
      "required": false,
      "secret": false,
      "generate": false
    }
  ],
  "update": {
    "strategy": "compose-pull-recreate"
  }
}
