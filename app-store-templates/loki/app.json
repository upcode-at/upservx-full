{
  "schema_version": 1,
  "id": "loki",
  "name": "Loki",
  "description": "Horizontally scalable, highly available log aggregation system inspired by Prometheus. Like Prometheus, but for logs.",
  "version": "3.5.3",
  "category": "monitoring",
  "icon": "🪵",
  "author": "Grafana Labs",
  "ports": [
    {
      "host": 3100,
      "container": 3100,
      "protocol": "tcp",
      "description": ""
    }
  ],
  "volumes": [
    {
      "host": "/opt/upcode-harbor/data/loki/data",
      "container": "/loki",
      "mode": "rw",
      "description": ""
    },
    {
      "host": "/opt/upcode-harbor/data/loki/config",
      "container": "/etc/loki",
      "mode": "rw",
      "description": ""
    }
  ],
  "environment": [
    {
      "name": "APP_DATA_DIR",
      "label": "App Data Dir",
      "description": "Managed per-installation data directory.",
      "default": "",
      "required": true,
      "secret": false,
      "generate": false,
      "managed": true
    }
  ],
  "update": {
    "strategy": "compose-pull-recreate"
  }
}
