#!/usr/bin/env python3
"""
upservx – UpservX CLI entry point.

This file is installed to /usr/local/bin/upservx during setup.
"""

import os
import sys

# Ensure the CLI package directory is on the path regardless of where the
# script is called from. The canonical install location is /opt/upservx/upservx-cli.
_SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
if _SCRIPT_DIR not in sys.path:
    sys.path.insert(0, _SCRIPT_DIR)

from cli.main import main

if __name__ == "__main__":
    sys.exit(main())
