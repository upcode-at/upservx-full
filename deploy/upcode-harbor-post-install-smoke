#!/usr/bin/env bash
set -euo pipefail

profile_file=/var/lib/upcode-harbor/install-profile
failures=0

pass() { printf 'PASS: %s\n' "$1"; }
fail() { printf 'FAIL: %s\n' "$1" >&2; failures=$((failures + 1)); }
check() {
  local message=$1
  shift
  if "$@" >/dev/null 2>&1; then pass "$message"; else fail "$message"; fi
}
has_group() { id -nG upcode-harbor | tr ' ' '\n' | grep -Fxq "$1"; }

check 'backend service account exists' id upcode-harbor
check 'frontend service account exists' id upcode-harbor-web
check 'current release is an atomic symlink' test -L /opt/upcode-harbor/current
check 'current release is root-owned' test "$(stat -c '%U:%G' "$(readlink -f /opt/upcode-harbor/current)")" = root:root
check 'configuration root is private' test "$(stat -c '%U:%G %a' /etc/upcode-harbor)" = 'upcode-harbor:upcode-harbor 700'
if find /etc/upcode-harbor -xdev -type l -print -quit | grep -q .; then
  fail 'configuration tree contains no symlinks'
else
  pass 'configuration tree contains no symlinks'
fi
while IFS= read -r -d '' path; do
  metadata=$(stat -c '%U:%G %a' "$path")
  if [[ -d $path ]]; then expected='upcode-harbor:upcode-harbor 700'; else expected='upcode-harbor:upcode-harbor 600'; fi
  [[ $metadata == "$expected" ]] || fail "secure ownership/mode for $path (got $metadata)"
done < <(find /etc/upcode-harbor -xdev -mindepth 1 \( -type d -o -type f \) -print0)
check 'privileged helper is root-owned and immutable to the service' test "$(stat -c '%U:%G %a' /usr/local/libexec/upcode-harbor-privileged)" = 'root:root 755'
check 'sudo policy is syntactically valid' visudo -cf /etc/sudoers.d/upcode-harbor
check 'dedicated PAM policy is installed' test "$(stat -c '%U:%G %a' /etc/pam.d/upcode-harbor)" = 'root:root 644'
check 'dedicated PAM policy delegates authentication' grep -Fxq '@include common-auth' /etc/pam.d/upcode-harbor
check 'root PAM broker dependency is installed' test -x /usr/bin/pamtester
check 'service can invoke only its helper' runuser -u upcode-harbor -- sudo -n /usr/local/libexec/upcode-harbor-privileged self-test
check 'SSH server is installed' test -x /usr/sbin/sshd
check 'SSH server is active' systemctl is-active --quiet ssh.service
check 'API unit is active' systemctl is-active --quiet upcode-harbor-api.service
check 'worker unit is active' systemctl is-active --quiet upcode-harbor-worker.service
check 'frontend unit is active' systemctl is-active --quiet upcode-harbor-web.service
check 'health timer is active' systemctl is-active --quiet upcode-harbor-health.timer
check 'API and frontend are ready' /usr/local/libexec/upcode-harbor-health-check all
check 'HTTPS reverse proxy is ready' curl -kfsS https://127.0.0.1/
check 'noVNC assets are present' test -f /opt/upcode-harbor/current/upcode-harbor/public/novnc/vnc.html

if [[ -r $profile_file ]]; then
  # shellcheck source=/dev/null
  . "$profile_file"
  if [[ ${WITH_DOCKER:-0} == 1 ]]; then
    check 'Docker CLI is installed' command -v docker
    check 'Docker service is active' systemctl is-active --quiet docker.service
    check 'Docker group is configured' has_group docker
  fi
  if [[ ${WITH_LXD:-0} == 1 ]]; then
    check 'LXC client is installed' command -v lxc
    check 'LXD group is configured' has_group lxd
  fi
  if [[ ${WITH_LIBVIRT:-0} == 1 ]]; then
    check 'libvirt CLI is installed' command -v virsh
    check 'libvirt group is configured' has_group libvirt
    check 'KVM group is configured' has_group kvm
    check 'ISO storage is writable by the backend' runuser -u upcode-harbor -- test -w /var/lib/libvirt/isos
  fi
  if [[ ${WITH_K3S:-0} == 1 ]]; then
    check 'K3s is installed' command -v k3s
    check 'kubectl is installed' command -v kubectl
    check 'K3s service is active' systemctl is-active --quiet k3s.service
  fi
  if [[ ${WITH_ZFS:-0} == 1 ]]; then
    check 'ZFS CLI is installed' command -v zfs
    check 'ZFS pool CLI is installed' command -v zpool
  fi
  [[ ${UPDATES_ENABLED:-0} == 0 ]] || check 'update verification key is installed' test -f /usr/share/upcode-harbor/update-public.pem
fi

if (( failures > 0 )); then
  printf '%d post-install smoke check(s) failed.\n' "$failures" >&2
  exit 1
fi
printf 'All Upcode Harbor post-install smoke checks passed.\n'
