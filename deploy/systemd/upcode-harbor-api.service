[Unit]
Description=Upcode Harbor API
After=network-online.target
Wants=network-online.target
PartOf=upcode-harbor.target

[Service]
Type=simple
User=upcode-harbor
Group=upcode-harbor
WorkingDirectory=/var/lib/upcode-harbor
Environment=HOME=/var/lib/upcode-harbor
Environment=PYTHONUNBUFFERED=1
Environment=UPCODE_HARBOR_SERVICE_USER=upcode-harbor
Environment=UPCODE_HARBOR_LOG_FILE=/var/log/upcode-harbor/api.log
Environment=UPCODE_HARBOR_API_HOST=127.0.0.1
Environment=PATH=/usr/local/libexec/upcode-harbor-bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=-/etc/upcode-harbor/service.env
ExecStart=/opt/upcode-harbor/current/upcode-harbor-service/venv/bin/python3 /opt/upcode-harbor/current/upcode-harbor-service/main.py
ExecStartPost=/usr/local/libexec/upcode-harbor-health-check wait-api
Restart=on-failure
RestartSec=3
TimeoutStartSec=60
TimeoutStopSec=30
KillMode=mixed
UMask=0077
PrivateTmp=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=false

[Install]
WantedBy=upcode-harbor.target
