[Unit]
Description=UpservX persistent job worker
After=network-online.target upservx-api.service
Wants=network-online.target
PartOf=upservx.target

[Service]
Type=simple
User=upservx
Group=upservx
WorkingDirectory=/var/lib/upservx
Environment=HOME=/var/lib/upservx
Environment=PYTHONUNBUFFERED=1
Environment=UPSERVX_SERVICE_USER=upservx
Environment=UPSERVX_LOG_FILE=/var/log/upservx/worker.log
Environment=PATH=/usr/local/libexec/upservx-bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=-/etc/upservx/service.env
ExecStart=/opt/upservx/current/upservx-service/venv/bin/python3 /opt/upservx/current/upservx-service/job_worker.py
Restart=always
RestartSec=3
TimeoutStopSec=45
KillMode=mixed
UMask=0077
PrivateTmp=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=false

[Install]
WantedBy=upservx.target
