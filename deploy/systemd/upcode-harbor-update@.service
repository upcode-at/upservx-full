[Unit]
Description=Install signed Upcode Harbor release %i
After=network-online.target
Wants=network-online.target
ConditionPathExists=/usr/share/upcode-harbor/update-public.pem

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/upcode-harbor-updater apply %i
TimeoutStartSec=2h
TimeoutStopSec=45
KillMode=mixed
UMask=0077
PrivateTmp=true
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
