#!/usr/bin/env python3
"""Local readiness/liveness probe used by systemd and the updater."""

from __future__ import annotations

import http.client
import sys
import time


def check(port: int, path: str) -> None:
    connection = http.client.HTTPConnection("127.0.0.1", port, timeout=4)
    try:
        connection.request("GET", path, headers={"Host": "localhost"})
        response = connection.getresponse()
        response.read(4096)
        if response.status != 200:
            raise RuntimeError(f"HTTP {response.status} from port {port}")
    finally:
        connection.close()


def main(target: str) -> int:
    wait = target.startswith("wait-")
    if wait:
        target = target.removeprefix("wait-")
    attempts = 30 if wait else 1
    try:
        if target not in {"api", "web", "all"}:
            raise RuntimeError("target must be api, web, or all")
        last_error: Exception | None = None
        for attempt in range(attempts):
            try:
                if target in {"api", "all"}:
                    check(9500, "/health/ready")
                if target in {"web", "all"}:
                    check(9200, "/login")
                return 0
            except Exception as error:
                last_error = error
                if attempt + 1 < attempts:
                    time.sleep(1)
        raise last_error or RuntimeError("health check failed")
    except Exception as error:
        print(f"UpservX {target} health check failed: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1] if len(sys.argv) == 2 else ""))
