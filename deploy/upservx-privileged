#!/usr/bin/env python3
"""Root-owned privilege boundary for the unprivileged Upcode Harbor backend.

This helper intentionally uses only the Python standard library.  The sudoers
policy permits the dedicated ``upservx`` account to invoke this file and
nothing else as root; every operation is validated again here.
"""

from __future__ import annotations

import ipaddress
import json
import os
import pwd
import re
import shutil
import stat
import subprocess
import sys
import tempfile
from pathlib import Path


SERVICE_USER = "upservx"
WEB_USER = "upservx-web"
HELPER_DIR = Path("/usr/local/libexec/upservx-bin")
NGINX_SITES_AVAILABLE = Path("/etc/nginx/sites-available")
NGINX_SITES_ENABLED = Path("/etc/nginx/sites-enabled")
UPDATE_UNIT_PREFIX = "upservx-update@"
VERSION_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")
NAME_RE = re.compile(r"^[a-z_][a-z0-9_.-]{0,31}$", re.IGNORECASE)
UNIT_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.@:-]{0,127}(?:\.service|\.socket|\.timer|\.target)?$")
HOST_RE = re.compile(r"^(?=.{1,253}$)[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?$")
INTERFACE_RE = re.compile(r"^[A-Za-z0-9_.:-]{1,32}$")
DOMAIN_RE = re.compile(
    r"^(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z]{2,63}$"
)
PROTECTED_USERS = {"root", SERVICE_USER, WEB_USER}
PROTECTED_GROUPS = {
    "root", "sudo", "wheel", SERVICE_USER, WEB_USER,
    "docker", "lxd", "lxc", "libvirt", "kvm",
}


class PolicyError(RuntimeError):
    """Raised when a requested privileged operation is outside policy."""


def _fail(message: str, exit_code: int = 2) -> int:
    print(message, file=sys.stderr)
    return exit_code


def _validate_invoker() -> None:
    if os.geteuid() != 0:
        raise PolicyError("the privileged helper must run as root")
    sudo_user = os.environ.get("SUDO_USER")
    if sudo_user and sudo_user != SERVICE_USER:
        raise PolicyError("caller is not the Upcode Harbor service account")


def _absolute_command(name: str) -> str:
    candidates = {
        "apt-get": ("/usr/bin/apt-get",),
        "certbot": ("/usr/bin/certbot",),
        "chpasswd": ("/usr/sbin/chpasswd",),
        "dhclient": ("/usr/sbin/dhclient", "/sbin/dhclient"),
        "fail2ban-client": ("/usr/bin/fail2ban-client",),
        "groupadd": ("/usr/sbin/groupadd",),
        "groupdel": ("/usr/sbin/groupdel",),
        "gpasswd": ("/usr/bin/gpasswd",),
        "hostnamectl": ("/usr/bin/hostnamectl",),
        "ip": ("/usr/sbin/ip", "/sbin/ip"),
        "mkfs.btrfs": ("/usr/sbin/mkfs.btrfs",),
        "mkfs.exfat": ("/usr/sbin/mkfs.exfat",),
        "mkfs.ext4": ("/usr/sbin/mkfs.ext4",),
        "mkfs.ntfs": ("/usr/sbin/mkfs.ntfs",),
        "mkfs.vfat": ("/usr/sbin/mkfs.vfat",),
        "mount": ("/usr/bin/mount", "/bin/mount"),
        "nft": ("/usr/sbin/nft",),
        "nginx": ("/usr/sbin/nginx",),
        "openvpn": ("/usr/sbin/openvpn",),
        "pamtester": ("/usr/bin/pamtester",),
        "systemctl": ("/usr/bin/systemctl",),
        "timedatectl": ("/usr/bin/timedatectl",),
        "umount": ("/usr/bin/umount", "/bin/umount"),
        "useradd": ("/usr/sbin/useradd",),
        "userdel": ("/usr/sbin/userdel",),
        "usermod": ("/usr/sbin/usermod",),
        "zfs": ("/usr/sbin/zfs",),
        "zpool": ("/usr/sbin/zpool",),
    }
    for candidate in candidates.get(name, ()):
        if Path(candidate).is_file():
            return candidate
    raise PolicyError(f"privileged command is not installed: {name}")


def _safe_name(value: str, *, protected: set[str] | None = None) -> str:
    if not NAME_RE.fullmatch(value):
        raise PolicyError("invalid account or group name")
    if protected and value in protected:
        raise PolicyError("the requested system principal is protected")
    return value


def _managed_login_user(value: str):
    _safe_name(value, protected=PROTECTED_USERS)
    try:
        account = pwd.getpwnam(value)
    except KeyError as error:
        raise PolicyError("user does not exist") from error
    if account.pw_uid < 1000:
        raise PolicyError("system accounts are outside authorized-key management")
    return account


def _safe_device(value: str) -> str:
    if value.startswith(("UUID=", "LABEL=")) and re.fullmatch(r"(?:UUID|LABEL)=[A-Za-z0-9_.:+-]{1,128}", value):
        return value
    resolved = os.path.realpath(value)
    if not resolved.startswith("/dev/") or not re.fullmatch(r"/dev/[A-Za-z0-9_./:+-]{1,180}", resolved):
        raise PolicyError("device must resolve below /dev")
    return value


def _safe_mountpoint(value: str) -> str:
    resolved = os.path.realpath(value)
    allowed = ("/mnt/", "/media/", "/var/lib/libvirt/isos/")
    if resolved in {"/mnt", "/media", "/var/lib/libvirt/isos"} or resolved.startswith(allowed):
        return resolved
    raise PolicyError("mount point is outside the managed storage roots")


def _validate_systemctl(args: list[str]) -> None:
    if not args or args[0] not in {
        "start", "stop", "restart", "reload", "enable", "disable",
        "is-active", "is-enabled", "status", "show", "list-units",
        "list-unit-files",
    }:
        raise PolicyError("systemctl action is not allowed")
    if args[0] in {"list-units", "list-unit-files"}:
        allowed = {"--type=service", "--state=active", "--no-legend", "--plain", "--all", "--no-pager"}
        if any(value not in allowed for value in args[1:]):
            raise PolicyError(f"unsupported {args[0]} option")
        return
    if args[0] == "show":
        if len(args) < 2 or not UNIT_RE.fullmatch(args[1]):
            raise PolicyError("invalid systemd unit")
        if any(not value.startswith("--property=") for value in args[2:]):
            raise PolicyError("unsupported systemctl show option")
        return
    if len(args) < 2 or any(not UNIT_RE.fullmatch(unit) for unit in args[1:]):
        raise PolicyError("invalid systemd unit")
    if any(unit.startswith(UPDATE_UNIT_PREFIX) for unit in args[1:]):
        raise PolicyError("update units require the dedicated update action")


def _validate_accounts(command: str, args: list[str]) -> None:
    shells = {"/bin/bash", "/bin/sh", "/bin/fish", "/bin/zsh", "/usr/bin/bash", "/usr/bin/sh", "/usr/bin/fish", "/usr/bin/zsh"}
    if command == "useradd":
        if not args or args[-1].startswith("-"):
            raise PolicyError("invalid useradd arguments")
        _safe_name(args[-1], protected=PROTECTED_USERS)
        index = 0
        while index < len(args) - 1:
            option = args[index]
            if option == "-m":
                index += 1
            elif option == "-s" and index + 1 < len(args) - 1 and args[index + 1] in shells:
                index += 2
            elif option == "-G" and index + 1 < len(args) - 1:
                for group in args[index + 1].split(","):
                    _safe_name(group)
                index += 2
            else:
                raise PolicyError("unsupported useradd option")
        return
    if command == "usermod":
        if len(args) != 3 or args[0] not in {"-s", "-G"}:
            raise PolicyError("unsupported usermod arguments")
        if args[0] == "-s" and args[1] not in shells:
            raise PolicyError("unsupported login shell")
        if args[0] == "-G":
            for group in args[1].split(",") if args[1] else []:
                _safe_name(group)
        _safe_name(args[2], protected=PROTECTED_USERS)
        return
    if command == "userdel":
        if len(args) != 2 or args[0] != "-r":
            raise PolicyError("userdel must use the managed recursive form")
        _safe_name(args[1], protected=PROTECTED_USERS)
        return
    if command in {"groupadd", "groupdel"}:
        if len(args) != 1:
            raise PolicyError(f"invalid {command} arguments")
        _safe_name(args[0], protected=PROTECTED_GROUPS)
        return
    if command == "gpasswd":
        if len(args) != 3 or args[0] != "-M":
            raise PolicyError("unsupported gpasswd arguments")
        for member in args[1].split(",") if args[1] else []:
            _safe_name(member)
        _safe_name(args[2], protected=PROTECTED_GROUPS)
        return
    if command == "chpasswd":
        if args:
            raise PolicyError("chpasswd does not accept arguments")
        line = sys.stdin.readline(8193)
        if len(line) > 8192 or "\n" in line.rstrip("\n") or ":" not in line:
            raise PolicyError("invalid password input")
        username, _password = line.rstrip("\n").split(":", 1)
        _safe_name(username, protected=PROTECTED_USERS)
        sys.stdin = open(os.devnull)
        completed = subprocess.run(
            [_absolute_command(command)],
            input=line,
            text=True,
            check=False,
        )
        raise SystemExit(completed.returncode)


def _validate_nft(args: list[str]) -> None:
    filtered = [value for value in args if value not in {"-j", "--json"}]
    if filtered[:2] == ["list", "ruleset"]:
        return
    if filtered[:2] == ["list", "chain"] and any(name in filtered for name in {"upservx_filter", "upservx_nat"}):
        return
    if filtered[:1] == ["-f"] and filtered == ["-f", "/etc/upservx/nftables.conf"]:
        return
    if not filtered or filtered[0] not in {"add", "insert", "delete", "flush"}:
        raise PolicyError("unsupported nftables operation")
    if not any(name in filtered for name in {"upservx_filter", "upservx_nat"}):
        raise PolicyError("nftables writes are limited to Upcode Harbor tables")


def _validate_exec(command: str, args: list[str]) -> None:
    if command == "systemctl":
        _validate_systemctl(args)
    elif command in {"useradd", "usermod", "userdel", "groupadd", "groupdel", "gpasswd", "chpasswd"}:
        _validate_accounts(command, args)
    elif command == "hostnamectl":
        if len(args) != 2 or args[0] != "set-hostname" or not HOST_RE.fullmatch(args[1]):
            raise PolicyError("invalid hostnamectl request")
    elif command == "timedatectl":
        if len(args) != 2 or args[0] != "set-timezone" or not (Path("/usr/share/zoneinfo") / args[1]).is_file():
            raise PolicyError("invalid timezone")
    elif command == "ip":
        filtered = [value for value in args if value not in {"-4", "-6", "-j", "-o", "-d"}]
        if not filtered or filtered[0] not in {"link", "addr", "route"}:
            raise PolicyError("ip is limited to link, address, and route operations")
        if any(value in {"netns", "exec", "xfrm"} for value in filtered):
            raise PolicyError("unsupported ip operation")
    elif command == "dhclient":
        filtered = [value for value in args if value != "-r"]
        if len(filtered) != 1 or not INTERFACE_RE.fullmatch(filtered[0]):
            raise PolicyError("invalid DHCP interface")
    elif command in {"mount", "umount"}:
        if command == "mount":
            if len(args) != 2:
                raise PolicyError("mount requires a device and managed mount point")
            _safe_device(args[0]); mountpoint = _safe_mountpoint(args[1])
            Path(mountpoint).mkdir(parents=True, exist_ok=True, mode=0o755)
        elif len(args) != 1:
            raise PolicyError("umount requires one target")
        else:
            try:
                _safe_device(args[0])
            except PolicyError:
                _safe_mountpoint(args[0])
    elif command.startswith("mkfs."):
        if not args:
            raise PolicyError("mkfs requires a device")
        _safe_device(args[-1])
        if any(value.startswith("--") for value in args[:-1]):
            raise PolicyError("long mkfs options are not allowed")
    elif command in {"zpool", "zfs"}:
        if not args or args[0] not in {"list", "status", "get", "create", "destroy", "set"}:
            raise PolicyError("unsupported ZFS operation")
        for value in args:
            if value.startswith("/dev/"):
                _safe_device(value)
    elif command == "nft":
        _validate_nft(args)
    elif command == "fail2ban-client":
        if args[:1] == ["status"] and len(args) <= 2 and all(NAME_RE.fullmatch(value) for value in args[1:]):
            return
        if len(args) == 4 and args[0] == "set" and args[2] == "unbanip" and NAME_RE.fullmatch(args[1]):
            ipaddress.ip_address(args[3])
            return
        raise PolicyError("unsupported Fail2Ban operation")
    elif command == "apt-get":
        package = r"[A-Za-z0-9][A-Za-z0-9.+-]*"
        valid = args in (["update", "-qq"], ["--just-print", "upgrade"], ["upgrade", "-y"])
        valid = valid or (
            len(args) == 5 and args[:4] == ["install", "--only-upgrade", "-y", "--"]
            and bool(re.fullmatch(package, args[4]))
        )
        if not valid:
            raise PolicyError("unsupported apt-get operation")
    elif command == "nginx":
        if args not in (["-t"], ["-v"]):
            raise PolicyError("nginx is limited to version and configuration tests")
    elif command == "certbot":
        if args == ["--version"]:
            return
        if not args or args[0] not in {"certonly", "renew", "certificates", "revoke"}:
            raise PolicyError("unsupported Certbot operation")
        forbidden = ("hook", "script", "config-dir", "work-dir", "logs-dir", "server")
        if any(any(word in value for word in forbidden) for value in args):
            raise PolicyError("unsafe Certbot option")
        for index, value in enumerate(args[:-1]):
            if value in {"-d", "--cert-name"} and not DOMAIN_RE.fullmatch(args[index + 1]):
                raise PolicyError("invalid certificate domain")
    elif command == "openvpn":
        expected_prefix = ["--config"]
        if len(args) != 6 or args[:1] != expected_prefix or args[2:4] != ["--writepid", "/run/upservx/openvpn.pid"] or args[4:] != ["--daemon", "upservx-openvpn"]:
            raise PolicyError("unsupported OpenVPN invocation")
        config = os.path.realpath(args[1])
        if not config.startswith("/etc/upservx/vpn/") or not config.endswith(".ovpn"):
            raise PolicyError("OpenVPN configuration is outside the managed directory")
    else:
        raise PolicyError(f"command is not in the privileged allowlist: {command}")


def execute_command(command: str, args: list[str]) -> int:
    _validate_exec(command, args)
    return subprocess.run([_absolute_command(command), *args], check=False).returncode


def authenticate_pam_user(username: str) -> int:
    """Authenticate one existing Linux user as root without exposing its password."""

    _safe_name(username)
    if username in {SERVICE_USER, WEB_USER}:
        raise PolicyError("service accounts cannot use interactive login")

    password_input = sys.stdin.buffer.read(4098)
    if (
        not password_input
        or len(password_input) > 4097
        or not password_input.endswith(b"\n")
        or b"\n" in password_input[:-1]
        or b"\r" in password_input
        or b"\x00" in password_input
    ):
        raise PolicyError("invalid PAM password input")

    try:
        completed = subprocess.run(
            [
                _absolute_command("pamtester"),
                "upservx",
                username,
                "authenticate",
                "acct_mgmt",
            ],
            input=password_input,
            capture_output=True,
            check=False,
            timeout=20,
            env={
                "PATH": "/usr/sbin:/usr/bin:/sbin:/bin",
                "LANG": "C.UTF-8",
            },
        )
    except subprocess.TimeoutExpired:
        return 1
    finally:
        password_input = b""

    # Never forward PAM conversation output: custom modules must not be able
    # to reflect credentials or other sensitive prompts into application logs.
    return 0 if completed.returncode == 0 else 1


def _atomic_write(path: Path, data: bytes, mode: int = 0o644) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "wb") as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def _nginx_locations(host: str, api_port: int, web_port: int) -> list[str]:
    return [
        "    location /api/ {",
        f"        proxy_pass http://{host}:{api_port}/;",
        "        proxy_http_version 1.1;",
        "        proxy_set_header Upgrade $http_upgrade;",
        "        proxy_set_header Connection 'upgrade';",
        "        proxy_set_header Host $host;",
        "        proxy_set_header X-Real-IP $remote_addr;",
        "        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;",
        "        proxy_set_header X-Forwarded-Proto $scheme;",
        "        proxy_hide_header WWW-Authenticate;",
        "    }",
        "    location /ws/ {",
        "        rewrite ^/ws/(.*)$ /$1 break;",
        f"        proxy_pass http://{host}:{api_port};",
        "        proxy_http_version 1.1;",
        "        proxy_set_header Upgrade $http_upgrade;",
        "        proxy_set_header Connection 'upgrade';",
        "        proxy_set_header Host $host;",
        "        proxy_set_header X-Real-IP $remote_addr;",
        "        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;",
        "        proxy_set_header X-Forwarded-Proto $scheme;",
        "        proxy_read_timeout 3600s;",
        "        proxy_send_timeout 3600s;",
        "    }",
        "    location / {",
        f"        proxy_pass http://{host}:{web_port};",
        "        proxy_http_version 1.1;",
        "        proxy_set_header Upgrade $http_upgrade;",
        "        proxy_set_header Connection 'upgrade';",
        "        proxy_set_header Host $host;",
        "    }",
    ]


def configure_nginx(args: list[str]) -> int:
    if len(args) != 6:
        raise PolicyError("configure-nginx requires domain, host, two ports, and TLS flags")
    domain, host, api_value, web_value, ssl_value, force_value = args
    if not DOMAIN_RE.fullmatch(domain):
        raise PolicyError("invalid proxy domain")
    try:
        ipaddress.ip_address(host)
    except ValueError:
        if not HOST_RE.fullmatch(host):
            raise PolicyError("invalid proxy backend host")
    try:
        api_port = int(api_value)
        web_port = int(web_value)
    except ValueError as error:
        raise PolicyError("invalid proxy port") from error
    if not 1 <= api_port <= 65535 or not 1 <= web_port <= 65535:
        raise PolicyError("invalid proxy port")
    if ssl_value not in {"0", "1"} or force_value not in {"0", "1"}:
        raise PolicyError("invalid proxy TLS flag")
    certificate = Path(f"/etc/letsencrypt/live/{domain}/fullchain.pem")
    private_key = Path(f"/etc/letsencrypt/live/{domain}/privkey.pem")
    tls = ssl_value == "1" and certificate.is_file() and private_key.is_file()
    force_tls = force_value == "1" and tls
    lines = [
        "server {", "    listen 80;", "    listen [::]:80;",
        f"    server_name {domain};",
        "    location ^~ /.well-known/acme-challenge/ {",
        "        root /var/www/html;", "        allow all;",
        "        default_type text/plain;", "    }",
    ]
    if force_tls:
        lines.extend(["    location / {", "        return 301 https://$server_name$request_uri;", "    }"])
    else:
        lines.extend(_nginx_locations(host, api_port, web_port))
    lines.append("}")
    if tls:
        lines.extend([
            "server {", "    listen 443 ssl;", "    listen [::]:443 ssl;",
            f"    server_name {domain};",
            f"    ssl_certificate {certificate};",
            f"    ssl_certificate_key {private_key};",
            "    ssl_protocols TLSv1.2 TLSv1.3;",
            "    ssl_ciphers HIGH:!aNULL:!MD5;",
            *_nginx_locations(host, api_port, web_port),
            "}",
        ])
    name = f"upservx_{domain.replace('.', '_')}"
    available = NGINX_SITES_AVAILABLE / name
    enabled = NGINX_SITES_ENABLED / name
    old_data = available.read_bytes() if available.is_file() and not available.is_symlink() else None
    old_enabled = enabled.is_symlink()
    _atomic_write(available, ("\n".join(lines) + "\n").encode(), 0o644)
    enabled.unlink(missing_ok=True)
    enabled.symlink_to(available)
    test = subprocess.run([_absolute_command("nginx"), "-t"], capture_output=True, text=True, check=False)
    if test.returncode != 0:
        enabled.unlink(missing_ok=True)
        if old_data is None:
            available.unlink(missing_ok=True)
        else:
            _atomic_write(available, old_data, 0o644)
            if old_enabled:
                enabled.symlink_to(available)
        raise PolicyError(f"nginx configuration test failed: {test.stderr.strip()}")
    return subprocess.run([_absolute_command("systemctl"), "reload", "nginx.service"], check=False).returncode


def delete_nginx(domain: str) -> int:
    if not DOMAIN_RE.fullmatch(domain):
        raise PolicyError("invalid proxy domain")
    name = f"upservx_{domain.replace('.', '_')}"
    available = NGINX_SITES_AVAILABLE / name
    enabled = NGINX_SITES_ENABLED / name
    enabled.unlink(missing_ok=True)
    available.unlink(missing_ok=True)
    test = subprocess.run([_absolute_command("nginx"), "-t"], capture_output=True, text=True, check=False)
    if test.returncode != 0:
        raise PolicyError(f"nginx configuration test failed after removal: {test.stderr.strip()}")
    return subprocess.run([_absolute_command("systemctl"), "reload", "nginx.service"], check=False).returncode


def _read_service_file(path_value: str, maximum: int = 1_000_000) -> bytes:
    path = Path(path_value)
    info = path.lstat()
    invoker_uid = pwd.getpwnam(SERVICE_USER).pw_uid
    if not stat.S_ISREG(info.st_mode) or info.st_uid != invoker_uid:
        raise PolicyError("staged input must be a regular file owned by the service account")
    if info.st_mode & 0o022 or info.st_size > maximum:
        raise PolicyError("staged input has unsafe permissions or size")
    with path.open("rb") as handle:
        return handle.read(maximum + 1)


def replace_nginx_config(domain: str, source: str) -> int:
    """Atomically replace one managed site and roll back failed validation/reload."""
    if not DOMAIN_RE.fullmatch(domain):
        raise PolicyError("invalid proxy domain")
    data = _read_service_file(source, 256_000)
    if not data or len(data) > 256_000:
        raise PolicyError("staged Nginx configuration has an invalid size")
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError as error:
        raise PolicyError("staged Nginx configuration must be UTF-8") from error
    if "\x00" in text:
        raise PolicyError("staged Nginx configuration contains a NUL byte")

    name = f"upservx_{domain.replace('.', '_')}"
    available = NGINX_SITES_AVAILABLE / name
    enabled = NGINX_SITES_ENABLED / name
    if not available.is_file() or available.is_symlink():
        raise PolicyError("managed Nginx configuration does not exist")
    if not enabled.is_symlink() or enabled.resolve(strict=False) != available.resolve():
        raise PolicyError("managed Nginx configuration is not enabled")

    old_data = available.read_bytes()
    _atomic_write(available, data, 0o644)
    test = subprocess.run(
        [_absolute_command("nginx"), "-t"],
        capture_output=True,
        text=True,
        check=False,
    )
    if test.returncode != 0:
        _atomic_write(available, old_data, 0o644)
        raise PolicyError(f"nginx configuration test failed: {test.stderr.strip()}")

    reload_result = subprocess.run(
        [_absolute_command("systemctl"), "reload", "nginx.service"],
        capture_output=True,
        text=True,
        check=False,
    )
    if reload_result.returncode != 0:
        _atomic_write(available, old_data, 0o644)
        subprocess.run(
            [_absolute_command("nginx"), "-t"],
            capture_output=True,
            text=True,
            check=False,
        )
        subprocess.run(
            [_absolute_command("systemctl"), "reload", "nginx.service"],
            capture_output=True,
            text=True,
            check=False,
        )
        detail = (reload_result.stderr or reload_result.stdout).strip()
        raise PolicyError(f"nginx reload failed; previous configuration restored: {detail}")
    return 0


def install_cron(source: str) -> int:
    data = _read_service_file(source, 256_000)
    text = data.decode("utf-8")
    executable_prefix = "/opt/upservx/current/upservx-service/venv/bin/python3 /opt/upservx/current/upservx-service/handlers/"
    for raw_line in text.splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        fields = line.split()
        if len(fields) < 8 or fields[5] != SERVICE_USER:
            raise PolicyError("cron entries must run as the service account")
        if not " ".join(fields[6:]).startswith(executable_prefix):
            raise PolicyError("cron command is outside the installed release")
        if not all(re.fullmatch(r"[0-9*,/-]+", value) for value in fields[:5]):
            raise PolicyError("invalid cron schedule")
    _atomic_write(Path("/etc/cron.d/upservx"), data, 0o644)
    return 0


def authorized_keys(action: str, username: str) -> int:
    account = _managed_login_user(username)
    ssh_directory = Path(account.pw_dir) / ".ssh"
    destination = ssh_directory / "authorized_keys"
    if action == "authorized-keys-read":
        if destination.exists():
            if destination.is_symlink() or not destination.is_file():
                raise PolicyError("unsafe authorized_keys path")
            sys.stdout.write(destination.read_text(encoding="utf-8"))
        return 0
    content = sys.stdin.read(1_000_001)
    if len(content) > 1_000_000:
        raise PolicyError("authorized_keys content exceeds the size limit")
    allowed_types = ("ssh-ed25519 ", "ssh-rsa ", "ecdsa-sha2-", "sk-ssh-ed25519@openssh.com ", "sk-ecdsa-sha2-")
    lines = []
    for line in content.splitlines():
        line = line.strip()
        if not line:
            continue
        if not line.startswith(allowed_types) or "\x00" in line or len(line) > 16384:
            raise PolicyError("invalid SSH public key")
        lines.append(line)
    ssh_directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chown(ssh_directory, account.pw_uid, account.pw_gid)
    os.chmod(ssh_directory, 0o700)
    _atomic_write(destination, ("\n".join(lines) + ("\n" if lines else "")).encode(), 0o600)
    os.chown(destination, account.pw_uid, account.pw_gid)
    return 0


def stop_openvpn() -> int:
    pidfile = Path("/run/upservx/openvpn.pid")
    if not pidfile.exists():
        return 0
    if pidfile.is_symlink() or not pidfile.is_file():
        raise PolicyError("unsafe OpenVPN pid file")
    try:
        pid = int(pidfile.read_text(encoding="ascii").strip())
    except ValueError as error:
        raise PolicyError("invalid OpenVPN pid file") from error
    if pid <= 1:
        raise PolicyError("invalid OpenVPN process id")
    process_cmdline = Path(f"/proc/{pid}/cmdline")
    if process_cmdline.exists() and b"openvpn" not in process_cmdline.read_bytes():
        raise PolicyError("pid file does not refer to OpenVPN")
    try:
        os.kill(pid, 15)
    except ProcessLookupError:
        pass
    pidfile.unlink(missing_ok=True)
    return 0


def _update_text_file(path: Path, transform) -> None:
    original = path.read_text(encoding="utf-8") if path.exists() else ""
    updated = transform(original)
    _atomic_write(path, updated.encode("utf-8"), 0o644)


def apply_system_settings() -> int:
    payload = json.load(sys.stdin)
    hostname = str(payload.get("hostname", "")).strip()
    ssh_port = payload.get("ssh_port")
    timezone = str(payload.get("timezone", "UTC"))
    if timezone.lower() == "utc":
        timezone = "UTC"
    deny_root = bool(payload.get("deny_root_login", False))
    if not HOST_RE.fullmatch(hostname):
        raise PolicyError("invalid hostname")
    if not isinstance(ssh_port, int) or not 1 <= ssh_port <= 65535:
        raise PolicyError("invalid SSH port")
    if not (Path("/usr/share/zoneinfo") / timezone).is_file():
        raise PolicyError("invalid timezone")

    def update_hosts(contents: str) -> str:
        lines = contents.splitlines()
        replacement = f"127.0.1.1\t{hostname}"
        changed = False
        for index, line in enumerate(lines):
            if line.startswith("127.0.1.1"):
                lines[index] = replacement
                changed = True
        if not changed:
            lines.append(replacement)
        return "\n".join(lines) + "\n"

    def update_sshd(contents: str) -> str:
        kept = [
            line for line in contents.splitlines()
            if not re.match(r"^\s*(?:Port|PermitRootLogin)\s+", line, re.IGNORECASE)
        ]
        kept.extend([f"Port {ssh_port}", f"PermitRootLogin {'no' if deny_root else 'prohibit-password'}"])
        return "\n".join(kept) + "\n"

    _update_text_file(Path("/etc/hosts"), update_hosts)
    _atomic_write(Path("/etc/hostname"), f"{hostname}\n".encode(), 0o644)
    _update_text_file(Path("/etc/ssh/sshd_config"), update_sshd)
    subprocess.run([_absolute_command("hostnamectl"), "set-hostname", hostname], check=True)
    subprocess.run([_absolute_command("timedatectl"), "set-timezone", timezone], check=True)
    subprocess.run([_absolute_command("systemctl"), "restart", "sshd.service"], check=True)
    return 0


def _fstab_options(value: str) -> str:
    if not re.fullmatch(r"[A-Za-z0-9_=.,:-]{1,256}", value):
        raise PolicyError("invalid fstab options")
    return value


def update_fstab(action: str, args: list[str]) -> int:
    path = Path("/etc/fstab")
    lines = path.read_text(encoding="utf-8").splitlines() if path.exists() else []
    if action == "fstab-add":
        if len(args) != 4:
            raise PolicyError("fstab-add requires device, mount point, filesystem, and options")
        device = _safe_device(args[0])
        mountpoint = _safe_mountpoint(args[1])
        filesystem = args[2]
        if filesystem not in {"ext2", "ext3", "ext4", "xfs", "btrfs", "ntfs", "vfat", "exfat", "zfs", "auto"}:
            raise PolicyError("unsupported filesystem")
        options = _fstab_options(args[3])
        lines = [line for line in lines if not (line.split()[:1] == [device] or len(line.split()) > 1 and line.split()[1] == mountpoint)]
        lines.append(f"{device}\t{mountpoint}\t{filesystem}\t{options}\t0\t2")
    else:
        if len(args) != 1:
            raise PolicyError("fstab-remove requires one target")
        target = args[0]
        try:
            target = _safe_device(target)
        except PolicyError:
            target = _safe_mountpoint(target)
        lines = [line for line in lines if target not in line.split()[:2]]
    backup = Path("/var/backups/upservx/fstab.pre-change")
    backup.parent.mkdir(parents=True, exist_ok=True)
    if path.exists():
        shutil.copy2(path, backup)
        os.chmod(backup, 0o600)
    _atomic_write(path, ("\n".join(lines) + "\n").encode(), 0o644)
    return 0


def request_update(version: str, action: str = "start") -> int:
    if not VERSION_RE.fullmatch(version):
        raise PolicyError("invalid update version")
    unit = f"{UPDATE_UNIT_PREFIX}{version}.service"
    return subprocess.run([_absolute_command("systemctl"), action, unit], check=False).returncode


def main(argv: list[str]) -> int:
    try:
        _validate_invoker()
        if not argv:
            raise PolicyError("missing privileged action")
        action, *args = argv
        if action == "self-test" and not args:
            _absolute_command("pamtester")
            print("upservx privilege helper: ok")
            return 0
        if action == "pam-authenticate" and len(args) == 1:
            return authenticate_pam_user(args[0])
        if action == "exec" and args:
            return execute_command(args[0], args[1:])
        if action == "install-cron" and len(args) == 1:
            return install_cron(args[0])
        if action in {"authorized-keys-read", "authorized-keys-write"} and len(args) == 1:
            return authorized_keys(action, args[0])
        if action == "stop-openvpn" and not args:
            return stop_openvpn()
        if action == "apply-system-settings" and not args:
            return apply_system_settings()
        if action == "configure-nginx":
            return configure_nginx(args)
        if action == "delete-nginx" and len(args) == 1:
            return delete_nginx(args[0])
        if action == "replace-nginx-config" and len(args) == 2:
            return replace_nginx_config(args[0], args[1])
        if action in {"fstab-add", "fstab-remove"}:
            return update_fstab(action, args)
        if action == "request-update" and len(args) == 1:
            return request_update(args[0], "start")
        if action == "cancel-update" and len(args) == 1:
            return request_update(args[0], "stop")
        raise PolicyError("privileged action is not allowed")
    except (PolicyError, ValueError, OSError, json.JSONDecodeError) as error:
        return _fail(f"refused privileged operation: {error}")
    except subprocess.CalledProcessError as error:
        return _fail(f"privileged operation failed with exit code {error.returncode}", error.returncode or 1)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
